# Optional public URL used for canonical application metadata.
# NEXT_PUBLIC_APP_URL=https://example.com

# Supabase transaction-pooler connection for the application (port 6543).
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Supabase direct connection for Prisma migrations (port 5432).
# DIRECT_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

# Keep real connection strings in the ignored .env.local file.

