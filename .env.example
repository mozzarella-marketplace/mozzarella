# Required, server-only PostgreSQL connection string used by Prisma Client at runtime.
# Against a pooled provider (e.g. Supabase), this should be the pooled connection string.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/mozzarella

# Required, server-only PostgreSQL connection string Prisma CLI uses for migrations.
# Against a pooled provider, this must be the direct (unpooled) connection string.
DIRECT_URL=postgresql://USER:PASSWORD@localhost:5432/mozzarella

# Optional public URL used for canonical application metadata.
# NEXT_PUBLIC_APP_URL=https://example.com
