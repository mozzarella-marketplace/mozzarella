generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model UserStory {
  id        String               @id @default(cuid())
  sessionId String               @unique
  content   String
  language  ProgrammingLanguage?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
}

model ConversationMessage {
  id        String           @id @default(cuid())
  sessionId String
  role      ConversationRole
  content   String
  createdAt DateTime         @default(now())

  @@index([sessionId, createdAt])
}

enum CustomerCategory {
  smallBusiness
  ticketingSystems
  managementAndData
}

enum ConversationRole {
  user
  assistant
}

enum DifficultyLevel {
  beginner
  intermediate
  advanced
}

enum ProgrammingLanguage {
  java
  csharp
}

model Customer {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  role         String
  businessName String           @map("business_name")
  city         String
  avatar       String
  category     CustomerCategory
  domain       String
  difficulty   DifficultyLevel
  rewardCoins  Int              @map("reward_coins")
  topic        String
  summary      String
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @default(now()) @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("customers")
}

model User {
  id                 String               @id @default(cuid())
  keycloakUserId     String               @unique @map("keycloak_user_id")
  classId            String               @map("class_id")
  userId             String               @map("user_id")
  class              Class                @relation(fields: [classId], references: [classId], onDelete: Restrict, onUpdate: Cascade)
  productTipProgress ProductTipProgress[]

  @@unique([classId, userId])
  @@index([classId])
  @@map("users")
}

model Class {
  id      String @id @default(cuid())
  classId String @unique @map("class_id")
  users   User[]

  @@map("classes")
}

model ProductTip {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key          String
  locale       String
  title        String
  body         String
  action       String
  isActive     Boolean  @default(true) @map("is_active")
  displayOrder Int      @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([locale, key])
  @@unique([locale, displayOrder])
  @@map("product_tips")
}

// One rotation cursor per student and locale: the display order of the last delivered tip.
model ProductTipProgress {
  userId           String   @map("user_id")
  locale           String
  lastDisplayOrder Int?     @map("last_display_order")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, locale])
  @@map("product_tip_progress")
}
