generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model UserStory {
  id        String   @id @default(cuid())
  sessionId String   @unique
  content   String
  language  ProgrammingLanguage?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ConversationMessage {
  id        String           @id @default(cuid())
  sessionId String
  role      ConversationRole
  content   String
  createdAt DateTime         @default(now())

  @@index([sessionId, createdAt])
}

enum CustomerCategory {
  smallBusiness
  ticketingSystems
  managementAndData
}

enum ConversationRole {
  user
  assistant
}

enum DifficultyLevel {
  beginner
  intermediate
  advanced
}

enum ProgrammingLanguage {
  java
  csharp
}

model Customer {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  role             String
  businessName     String           @map("business_name")
  city             String
  avatar           String
  category         CustomerCategory
  domain           String
  difficulty       DifficultyLevel
  rewardCoins      Int              @map("reward_coins")
  topic            String
  summary          String
  isActive         Boolean          @default(true) @map("is_active")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("customers")
}

model User {
  id             String @id @default(cuid())
  keycloakUserId String @unique @map("keycloak_user_id")
  classId        String @map("class_id")
  userId         String @map("user_id")
  class          Class  @relation(fields: [classId], references: [classId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([classId, userId])
  @@index([classId])
  @@map("users")
}

model Class {
  id      String @id @default(cuid())
  classId String @unique @map("class_id")
  users   User[]

  @@map("classes")
}
