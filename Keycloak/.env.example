# Local Compose only. Copy to .env in this directory and fill every value.
# Use distinct, generated passwords. Never commit .env or reuse Railway secrets.
KC_BOOTSTRAP_ADMIN_USERNAME=
KC_BOOTSTRAP_ADMIN_PASSWORD=

# Dedicated local Keycloak PostgreSQL, never the application/Supabase database.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Dedicated local application PostgreSQL. Use different credentials from Keycloak.
# Set DATABASE_URL and DIRECT_URL in ../.env.local to this database on localhost:5432.
APP_POSTGRES_DB=
APP_POSTGRES_USER=
APP_POSTGRES_PASSWORD=